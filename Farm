--========================================================--

local function activateManual(name)

    autoLevelEnabled = false

    activeFarm = name

    healTriggered = false

    resetButtons()

    local button =
        buttons[name]

    if button then

        button.Text =
            name .. " [AÇIK]"

        button.BackgroundColor3 =
            Color3.fromRGB(60, 30, 90)

        button.TextColor3 =
            Color3.fromRGB(255, 255, 255)

    end

end

--========================================================--
-- MANUAL BUTTONLAR
--========================================================--

