-- PORTALA ISINLANMA
--==================================================

local function teleportToPortal(portal, farmName)
    if activeFarm ~= farmName then
        return false
    end

    local succeeded, err = pcall(function()
        local character = player.Character

        if not character then
            character = player.CharacterAdded:Wait()
        end

        local root = character:WaitForChild("HumanoidRootPart", 10)

        if not root or activeFarm ~= farmName then
            return false
        end

        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.CFrame = portal
        return true
    end)

    if not succeeded then
        warn("Portal teleport failed: " .. tostring(err))
        return false
    end

    return err == true
end

--==================================================
-- PORTALA YURUYEREK GITME
-- 200 stud'dan uzaksa false doner (isinlanmaya duser)
--==================================================

local function walkToPortal(portal, farmName)
    if activeFarm ~= farmName then
        return false
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid or humanoid.Health <= 0 then
        return false
    end

    local target = portal.Position
    local startFlat = Vector3.new(
        target.X - root.Position.X,
        0,
        target.Z - root.Position.Z
    )

    if startFlat.Magnitude > 200 then
        return false
    end

    local startedAt = tick()
    local lastPos = root.Position
    local lastCheck = tick()

    while activeFarm == farmName do
        character = player.Character
        root = character and character:FindFirstChild("HumanoidRootPart")
        humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if not root or not humanoid or humanoid.Health <= 0 then
            return false
        end

        local flat = Vector3.new(
            target.X - root.Position.X,
            0,
            target.Z - root.Position.Z
        )

        if flat.Magnitude < 3 then
            return true
        end

        if tick() - startedAt > 25 then
            return false
        end

        humanoid:MoveTo(target)

        -- takilirsa zipla
        if tick() - lastCheck >= 1 then
            if (root.Position - lastPos).Magnitude < 1 then
                humanoid.Jump = true
            end

            lastPos = root.Position
            lastCheck = tick()
        end

        task.wait(0.1)
    end

    return false
end

--==================================================
-- UCARAK GITME (WATERCOOLER)
--==================================================

local function flyToCFrame(farmName, targetCFrame)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return false, "HumanoidRootPart was not found"
    end

    local startCFrame = root.CFrame
    local distance = (targetCFrame.Position - startCFrame.Position).Magnitude
    local duration = math.max(distance / 120, 0.75)
    local startedAt = tick()

    setStatus(string.format("Flying to Watercooler; %.0f studs to target", distance))

    while true do
        if activeFarm ~= farmName then
            return false, "cancelled"
        end

        character = player.Character
        root = character and character:FindFirstChild("HumanoidRootPart")

        if not root then
            return false, "HumanoidRootPart disappeared during flight"
        end

        local alpha = math.min((tick() - startedAt) / duration, 1)
        root.CFrame = startCFrame:Lerp(targetCFrame, alpha)
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

        if alpha >= 1 then
            return true
        end

        RunService.Heartbeat:Wait()
    end
end

--==================================================
-- WATERCOOLER FARMI
--==================================================

local function runWatercoolerFarm(farmName, config)
    if activeFarm ~= farmName then
        return
    end

    local function waitForLivingCharacter()
        while activeFarm == farmName do
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if humanoid and humanoid.Health > 0 and root then
                task.wait(0.75)

                local currentCharacter = player.Character
                local currentHumanoid = currentCharacter
                    and currentCharacter:FindFirstChildOfClass("Humanoid")
                local currentRoot = currentCharacter
                    and currentCharacter:FindFirstChild("HumanoidRootPart")

                if currentCharacter == character
                    and currentHumanoid == humanoid
                    and currentHumanoid.Health > 0
                    and currentRoot == root then
                    return character, humanoid, root
                end
            else
                setStatus("Waiting for character to respawn")
                task.wait(0.1)
            end
        end

        return nil, nil, nil
    end

    local character, humanoid, root = waitForLivingCharacter()

    if not character then
        return
    end

    local entryCharacter = character
    local bossAlreadyActive = findClosestBossModel(config.bossName, root.Position) ~= nil

    if bossAlreadyActive and not watercoolerNeedsReentry then
        setStatus("Watercooler fight already active; skipping entry teleport")
    else
        setStatus("Entering the Watercooler fight")

        local succeeded, err = pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = config.bossPosition
        end)

        if not succeeded then
            warn("Watercooler position teleport failed: " .. tostring(err))
            farmNeedsTeleport = true
            setStatus("Could not reach the Watercooler position")
            task.wait(1)
            return
        end

        watercoolerNeedsReentry = false
    end

    if activeFarm ~= farmName then
        return
    end

    task.wait(0.5)

    character, humanoid, root = waitForLivingCharacter()

    if not character then
        return
    end

    if activeFarm == farmName and character ~= entryCharacter then
        setStatus("Respawn detected; re-entering the Watercooler fight")

        local reentrySucceeded, reentryError = pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = config.bossPosition
        end)

        if not reentrySucceeded then
            warn("Watercooler re-entry after respawn failed: " .. tostring(reentryError))
            watercoolerNeedsReentry = true
            farmNeedsTeleport = true
            return
        end

        watercoolerNeedsReentry = false
    end

    setStatus("At Watercooler; waiting 3 seconds before approaching the active boss")

    for _ = 1, 30 do
        if activeFarm ~= farmName then
            return
        end

        task.wait(0.1)
    end

    if activeFarm ~= farmName then
        return
    end

    setStatus("Searching all slots for the nearest Watercooler")

    local targetBoss = nil

    while activeFarm == farmName and not targetBoss do
        character = player.Character
        root = character and character:FindFirstChild("HumanoidRootPart")

        if root then
            targetBoss = findClosestBossModel(config.bossName, root.Position)
        end

        if not targetBoss then
            task.wait(0.2)
        end
    end

    if activeFarm ~= farmName then
        return
    end

    local function getBossApproachCFrame(boss)
        local bossPosition = getWatercoolerPartPosition(boss, {"Hitbox", "Torso", "Head"})
        local currentCharacter = player.Character
        local currentRoot = currentCharacter
            and currentCharacter:FindFirstChild("HumanoidRootPart")

        if not currentRoot then
            return nil
        end

        local horizontalDirection = Vector3.new(
            bossPosition.X - currentRoot.Position.X,
            0,
            bossPosition.Z - currentRoot.Position.Z
        )

        if horizontalDirection.Magnitude <= 0.01 then
            horizontalDirection = Vector3.new(
                boss:GetPivot().LookVector.X,
                0,
                boss:GetPivot().LookVector.Z
            )
        end

        if horizontalDirection.Magnitude <= 0.01 then
            horizontalDirection = Vector3.new(1, 0, 0)
        end

        local cornerDirection = CFrame.Angles(0, math.rad(45), 0)
            :VectorToWorldSpace(-horizontalDirection.Unit)
        local approachOffset = cornerDirection * 90

        local approachPosition = bossPosition
            + Vector3.new(0, 12, 0)
            + approachOffset

        local aimPosition = getWatercoolerAimPosition(boss)
        local horizontalAimPosition = Vector3.new(
            aimPosition.X,
            approachPosition.Y,
            aimPosition.Z
        )

        return CFrame.lookAt(approachPosition, horizontalAimPosition)
    end

    local function flyToBossApproach(boss)
        local currentCharacter = player.Character
        local currentRoot = currentCharacter
            and currentCharacter:FindFirstChild("HumanoidRootPart")

        if not currentRoot then
            return false, "HumanoidRootPart was not found"
        end

        if not isBossModelActive(boss) then
            return false, "boss disappeared during approach"
        end

        setStatus("Rising before flying diagonally to the Watercooler corner")

        local verticalTarget = CFrame.new(
            currentRoot.Position + Vector3.new(0, 12, 0)
        ) * currentRoot.CFrame.Rotation

        local rose, riseError = flyToCFrame(farmName, verticalTarget)

        if not rose then
            return false, riseError
        end

        if not isBossModelActive(boss) then
            return false, "boss disappeared during approach"
        end

        local approachCFrame = getBossApproachCFrame(boss)

        if not approachCFrame then
            return false, "HumanoidRootPart was not found"
        end

        setStatus("Flying directly toward the active Watercooler")

        return flyToCFrame(farmName, approachCFrame)
    end

    local function startWatercoolerAttack()
        task.wait(0.2)

        if activeFarm ~= farmName then
            return false, "cancelled"
        end

        if not holdCenterMouse() then
            releaseHeldInputs()
            return false, "could not hold center click"
        end

        setStatus("Near Watercooler; holding center click")
        return true
    end

    local movedToBoss = false

    while activeFarm == farmName and not movedToBoss do
        if not targetBoss or not isBossModelActive(targetBoss) then
            character = player.Character
            root = character and character:FindFirstChild("HumanoidRootPart")

            if root then
                targetBoss = findClosestBossModel(config.bossName, root.Position)
            end

            if not targetBoss then
                setStatus("Waiting for an active Watercooler in any slot")
                task.wait(0.2)
            end
        end

        if targetBoss and isBossModelActive(targetBoss) then
            local flightError
            movedToBoss, flightError = flyToBossApproach(targetBoss)

            if movedToBoss and not isBossModelActive(targetBoss) then
                movedToBoss = false
                targetBoss = nil
            end

            if not movedToBoss then
                if flightError == "cancelled" then
                    return
                elseif flightError == "boss disappeared during approach" then
                    targetBoss = nil
                    task.wait(0.2)
                else
                    warn("Watercooler approach flight failed: " .. tostring(flightError))
                    setStatus("Could not reach Watercooler; retrying")
                    farmNeedsTeleport = true
                    return
                end
            end
        end
    end

    if activeFarm ~= farmName or not movedToBoss then
        return
    end

    -- havada sabit kalma
    local hoverCFrame = nil
    local hoverConnection = RunService.Heartbeat:Connect(function()
        if activeFarm ~= farmName or not hoverCFrame then
            return
        end

        local currentCharacter = player.Character
        local currentRoot = currentCharacter
            and currentCharacter:FindFirstChild("HumanoidRootPart")

        if currentRoot then
            local positionDrift = (currentRoot.Position - hoverCFrame.Position).Magnitude
            local facingAlignment = currentRoot.CFrame.LookVector:Dot(hoverCFrame.LookVector)

            if positionDrift > 0.15 or facingAlignment < 0.995 then
                currentRoot.CFrame = hoverCFrame
            end

            if currentRoot.AssemblyLinearVelocity.Magnitude > 0.25 then
                currentRoot.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end)

    character = player.Character
    root = character and character:FindFirstChild("HumanoidRootPart")

    if root then
        hoverCFrame = root.CFrame
    else
        hoverConnection:Disconnect()
        warn("Watercooler farm stopped: character root was lost before attack")
        setStatus("Character root lost; retrying Watercooler farm")
        farmNeedsTeleport = true
        releaseHeldInputs()
        return
    end

    farmNeedsTeleport = false

    local attackStarted, attackError = startWatercoolerAttack()

    if not attackStarted then
        if attackError ~= "cancelled" then
            warn("Could not start Watercooler attack: " .. tostring(attackError))
            setStatus("Could not start attack; retrying")
            farmNeedsTeleport = true
        end

        hoverConnection:Disconnect()
        releaseHeldInputs()
        return
    end

    if activeFarm ~= farmName then
        hoverConnection:Disconnect()
        releaseHeldInputs()
        return
    end

    if not heldMousePosition then
        warn("Watercooler attack started without a held mouse button")
        setStatus("Attack input was lost; retrying")
        farmNeedsTeleport = true
        hoverConnection:Disconnect()
        releaseHeldInputs()
        return
    end

    local missingSince = nil

    while activeFarm == farmName do
        character = player.Character
        humanoid = character and character:FindFirstChildOfClass("Humanoid")
        root = character and character:FindFirstChild("HumanoidRootPart")

        if not humanoid or humanoid.Health <= 0 then
            setStatus("Character died; releasing attack and waiting to respawn")
            farmNeedsTeleport = true
            watercoolerNeedsReentry = true
            hoverConnection:Disconnect()
            releaseHeldInputs()
            return
        elseif root then
            root.AssemblyLinearVelocity = Vector3.zero
        else
            warn("Watercooler character root was lost; retrying farm")
            setStatus("Character lost; retrying Watercooler farm")
            farmNeedsTeleport = true
            hoverConnection:Disconnect()
            releaseHeldInputs()
            return
        end

        -- Boss varken mouse surekli basili kalir (yenileme yok).
        -- Boss kaybolunca birakilir, geri gelirse tekrar basilir.
        if targetBoss and isBossModelActive(targetBoss) then
            missingSince = nil

            if not heldMousePosition then
                holdCenterMouse()
            end
        elseif targetBoss then
            missingSince = missingSince or tick()
            releaseHeldMouse()

            if tick() - missingSince >= 0.75 then
                registerKill(farmName)
                releaseHeldMouse()
                hoverCFrame = nil
                targetBoss = nil
                missingSince = nil
                setStatus("Watercooler defeated; returning safe for 5 seconds")
                goWatercoolerSafe()

                for _ = 1, 50 do
                    if activeFarm ~= farmName then
                        hoverConnection:Disconnect()
                        return
                    end

                    task.wait(0.1)
                end

                if activeFarm == farmName then
                    farmNeedsTeleport = true
                    watercoolerNeedsReentry = true
                    setStatus("5-second safe wait complete; re-entering Watercooler")
                end

                hoverConnection:Disconnect()
                return
            end
        end

        if not targetBoss then
            character = player.Character
            root = character and character:FindFirstChild("HumanoidRootPart")

            if root then
                local nextBoss = findClosestBossModel(config.bossName, root.Position)

                if nextBoss then
                    hoverCFrame = nil

                    local reachedBoss, nextFlightError = flyToBossApproach(nextBoss)

                    if reachedBoss then
                        targetBoss = nextBoss
                        character = player.Character
                        root = character and character:FindFirstChild("HumanoidRootPart")

                        if root then
                            hoverCFrame = root.CFrame
                        else
                            warn("Watercooler attack could not start: character root was lost")
                            setStatus("Character root lost; retrying Watercooler farm")
                            farmNeedsTeleport = true
                            hoverConnection:Disconnect()
                            releaseHeldInputs()
                            return
                        end

                        local attackStarted2, attackError2 = startWatercoolerAttack()

                        if not attackStarted2 then
                            if attackError2 ~= "cancelled" then
                                warn("Could not start next Watercooler attack: " .. tostring(attackError2))
                                setStatus("Could not start next attack; retrying")
                                farmNeedsTeleport = true
                            end

                            hoverConnection:Disconnect()
                            releaseHeldInputs()
                            return
                        end

                        if activeFarm ~= farmName then
                            farmNeedsTeleport = true
                            hoverConnection:Disconnect()
                            releaseHeldInputs()
                            return
                        end
                    elseif nextFlightError == "boss disappeared during approach" then
                        setStatus("Watercooler disappeared; searching every slot again")
                    elseif nextFlightError ~= "cancelled" then
                        warn("Watercooler re-approach failed: " .. tostring(nextFlightError))
                        setStatus("Could not reach next Watercooler; retrying")
                        farmNeedsTeleport = true
                        hoverConnection:Disconnect()
                        releaseHeldInputs()
                        return
                    end
                end
            end
        end

        task.wait(0.1)
    end

    hoverConnection:Disconnect()
    releaseHeldInputs()
end

--==================================================
-- FS EMERALD PAPYRUS OZEL SAVAS
-- Acilis: 1 ile bir vurus, 2 ile bir vurus, tekrar 1
-- Can <= %50: 4 numarali esyayi sec ve kullan
-- Can <= %30: 3 numarali esyayi sec ve kullan
-- Iyilestirme tamamlanmadan otomatik saldiri yapma.
--==================================================

local fsHealInProgress = false

local function useHealItem(key, equipWait, holdTime, castTime)
    if fsHealInProgress then
        return false
    end

    fsHealInProgress = true
    local succeeded, err = pcall(function()
        -- Once ilgili esyayi eline al.
        pressKey(key)
        task.wait(equipWait)

        -- Eline aldiktan sonra sol tikla kullan.
        local camera = workspace.CurrentCamera
        if not camera then
            error("CurrentCamera is unavailable")
        end

        local viewport = camera.ViewportSize
        local clickX = viewport.X / 2
        local clickY = viewport.Y / 2

        VIM:SendMouseButtonEvent(clickX, clickY, 0, true, game, 1)
        task.wait(holdTime)
        VIM:SendMouseButtonEvent(clickX, clickY, 0, false, game, 1)

        -- Esya kullanimi tamamlansin; sonra kilica don.
        task.wait(castTime)
        equipSword()
    end)

    fsHealInProgress = false

    if not succeeded then
        warn("FS Emerald heal item failed: " .. tostring(err))
        return false
    end

    return true
end

local function useSecondWeaponOnce()
    if fsHealInProgress then
        return
    end

    pressKey(Enum.KeyCode.Two)
    task.wait(0.15)
    centerClick()
    task.wait(0.2)
    equipSword()
end

local function runFsFight(farmName, config)
    -- Acilis
    equipSword()
    task.wait(0.15)
    centerClick()
    task.wait(0.2)
    useSecondWeaponOnce()

    local lastSecond = tick()
    local lastClick = 0

    while activeFarm == farmName do
        if not findBossModel(config.bossName, config.prefixMatch) then
            registerKill(farmName)
            farmNeedsTeleport = true
            setStatus("Boss defeated")

            task.wait(2)
            afterKill(config)
            return
        end

        -- Universal autoheal handles every boss, including FS Emerald.
        -- Pause attack input while the shared heal routine is selecting/using an item.
        if not healing and not fsHealInProgress then
            if tick() - lastSecond >= 20 then
                lastSecond = tick()
                useSecondWeaponOnce()
            end

            if tick() - lastClick >= 0.10 then
                centerClick()
                lastClick = tick()
            end
        end

        task.wait(0.03)
    end
end

--==================================================
-- BOSS FARMI
--==================================================

local function runBoss(farmName)
    if activeFarm ~= farmName then
        return
    end

    local config = farmConfigs[farmName]

    if not config then
        setStatus("Farm configuration not found")
        return
    end

    if config.otherWorld then
        local succeeded, err = pcall(function()
            runWatercoolerFarm(farmName, config)
        end)

        if not succeeded then
            warn("Watercooler farm failed: " .. tostring(err))
            releaseHeldInputs()

            if activeFarm == farmName then
                farmNeedsTeleport = true
                setStatus("Watercooler farm error; retrying")
                task.wait(1)
            end
        end

        return
    end

    local bossBeforeSpecial = nil
    local offHeadSlot = nil

    --==============================================
    -- PORTALA GIT (BOSS YOKSA YA DA ISINLANMA GEREKIYORSA)
    --==============================================

    local bossAlreadyPresent = false

    if config.offHeadDeathBySlot then
        bossAlreadyPresent = findOffHeadSlot() ~= nil
    else
        bossAlreadyPresent = findBossModel(config.bossName, config.prefixMatch) ~= nil
    end

    if farmNeedsTeleport or not bossAlreadyPresent then
        local arrived = false

        if config.walk then
            setStatus("Walking to the " .. config.displayName .. " portal")
            arrived = walkToPortal(config.portal, farmName)

            if activeFarm ~= farmName then
                return
            end
        end

        if not arrived then
            setStatus("Teleporting to the " .. config.displayName .. " portal")
            arrived = teleportToPortal(config.portal, farmName)

            if activeFarm ~= farmName then
                return
            end
        end

        if not arrived then
            farmNeedsTeleport = true
            setStatus("Could not reach portal; retrying")
            task.wait(1)
            return
        end

        pressKey(Enum.KeyCode.W)
    end

    --==============================================
    -- GIRIS BEKLEMESI
    -- FS Emerald: hemen 5 yetenegi, sonra 5 saniye bekle
    -- Digerleri: 6 saniye kalkan beklemesi
    --==============================================

    if config.fsCombat then
        setStatus("Using special ability")
        useSpecialAbility()

        if activeFarm ~= farmName then
            return
        end

        setStatus("Waiting 5 seconds")

        local waitTime = 0

        while waitTime < 5 do
            if activeFarm ~= farmName then
                return
            end

            task.wait(0.5)
            waitTime += 0.5
        end
    else
        setStatus("Waiting 6 seconds for the shield")

        local shieldTime = 0

        while shieldTime < 6 do
            if activeFarm ~= farmName then
                return
            end

            task.wait(0.5)
            shieldTime += 0.5
        end
    end

    if activeFarm ~= farmName then
        return
    end

    --==============================================
    -- HEDEF BOSSU BEKLE
    --==============================================

    setStatus("Searching for " .. config.displayName)

    local boss = findBossModel(config.bossName, config.prefixMatch)
    local searchStart = tick()

    if config.offHeadDeathBySlot then
        local slotSearchStart = tick()

        while not offHeadSlot
            and activeFarm == farmName
            and tick() - slotSearchStart < 60 do

            task.wait(0.15)
            offHeadSlot = findOffHeadSlot()
        end

        if activeFarm ~= farmName then
            return
        end

        if not offHeadSlot then
            farmNeedsTeleport = true
            setStatus("OffHead slot not found; retrying")
            return
        end
    else
        while not boss
            and activeFarm == farmName
            and tick() - searchStart < 60 do

            task.wait(0.15)
            boss = findBossModel(config.bossName, config.prefixMatch)
        end

        if activeFarm ~= farmName then
            return
        end

        if not boss then
            farmNeedsTeleport = true
            setStatus(config.displayName .. " not found; retrying")
            return
        end
    end

    farmNeedsTeleport = false
    bossBeforeSpecial = boss
    setStatus(config.displayName .. " found; starting attack")

    --==============================================
    -- FS EMERALD: OZEL SAVAS DONGUSU
    --==============================================

    if config.fsCombat then
        setStatus("Fighting " .. config.displayName)
        runFsFight(farmName, config)
        return
    end

    --==============================================
    -- SALDIRI: 5 -> 1 -> TIKLAMA
    --==============================================

    if config.special then
        setStatus("Using special ability")
        useSpecialAbility()

        if activeFarm ~= farmName then
            return
        end

        -- 5'ten sonra her zaman 1'e bas
        equipSword()

        task.wait(0.15)
    else
        equipSword()
    end

    setStatus("Fighting " .. config.displayName)

    --==============================================
    -- 5 TUSU TEK BASINA BOSSU OLDURDU MU?
    --==============================================

    if config.offHeadDeathBySlot then
        if offHeadSlot and not offHeadSlotExists(offHeadSlot) then
            registerKill(farmName)
            farmNeedsTeleport = true
            setStatus("Boss defeated")

            task.wait(2)

            afterKill(config)

            return
        end
    elseif bossBeforeSpecial then
        if not findBossModel(config.bossName, config.prefixMatch) then
            registerKill(farmName)
            farmNeedsTeleport = true
            setStatus("Boss defeated")

            task.wait(2)

            afterKill(config)

            return
        end
    end

    --==============================================
    -- NORMAL OTOMATIK TIKLAMA
    --==============================================

    local lastClick = 0

    while activeFarm == farmName do
        if activeFarm ~= farmName then
            return
        end

        if config.offHeadDeathBySlot then
            -- Off Head olumu = ActiveBosses slotunun kaybolmasi
            if not offHeadSlotExists(offHeadSlot) then
                registerKill(farmName)
                farmNeedsTeleport = true
                setStatus("Boss defeated")

                task.wait(2)

                afterKill(config)

                return
            end
        else
            boss = findBossModel(config.bossName, config.prefixMatch)

            if not boss then
                registerKill(farmName)
                farmNeedsTeleport = true
                setStatus("Boss defeated")

                task.wait(2)

                afterKill(config)

                return
            end
        end

        if not healing and tick() - lastClick >= 0.10 then
            centerClick()
            lastClick = tick()
        end

        task.wait(0.03)
    end
end

