    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 11)
    corner.Parent = button

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(45, 46, 57)
    stroke.Parent = button

    buttons[name] = button

    button.MouseButton1Click:Connect(function()

        if activeFarm == name then

            activeFarm = nil

            button.Text = bossDisplay[name] .. "\n[KAPALI]"
            button.BackgroundColor3 =
                Color3.fromRGB(25, 26, 34)

            button.TextColor3 =
                Color3.fromRGB(190, 190, 200)

            statusLabel.Text = "● Farm kapalı"

        else

            activeFarm = name

            for bossName, otherButton in pairs(buttons) do

                otherButton.Text =
                    bossDisplay[bossName] .. "\n[KAPALI]"

                otherButton.BackgroundColor3 =
                    Color3.fromRGB(25, 26, 34)

                otherButton.TextColor3 =
                    Color3.fromRGB(190, 190, 200)

