local function getLevel()

    local result = 0

    pcall(function()

        local leaderstats =
            player:FindFirstChild("leaderstats")

        if leaderstats then

            local lv =
                leaderstats:FindFirstChild("LV")

            if lv then
                result =
                    tonumber(lv.Value) or 0
            end
        end

    end)

    return result
end

