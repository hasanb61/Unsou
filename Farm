local function setButtonState(farmName, isOn)
    local button = bossButtons[farmName]

    if not button and farmName == "Watercooler" then
        button = otherWorldButton
    end

    if not button then
        return
    end

    local config = farmConfigs[farmName]

    if isOn then
        button.Text = config.displayName .. " [ON]"
        button.BackgroundColor3 = ON_COLOR
        button.TextColor3 = ON_TEXT
    else
        button.Text = config.displayName .. " [OFF]"
        button.BackgroundColor3 = OFF_COLOR
        button.TextColor3 = OFF_TEXT
    end
end

local function resetBossButtons()
    for _, farmName in ipairs(bossOrder) do
        setButtonState(farmName, false)
    end

    setButtonState("Watercooler", false)
end

local setAutoLevelState

