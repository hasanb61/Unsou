local function findBossModel(bossName)

    local activeBosses = workspace:FindFirstChild("ActiveBosses")

    if not activeBosses then
        return nil
    end

    for _, slot in ipairs(activeBosses:GetChildren()) do

        local bossesFolder = slot:FindFirstChild("Bosses")

        if bossesFolder then

            for _, obj in ipairs(bossesFolder:GetDescendants()) do

                if obj.Name == bossName then
                    return obj
                end

            end

        end

    end

    return nil

end

local function waitForBoss(bossName, timeout)

    local start = tick()

    while tick() - start < timeout do

        if activeFarm == nil then
            return nil
        end

        local boss = findBossModel(bossName)

        if boss then
            return boss
        end

        task.wait(0.1)

    end

    return nil

end

--============================================================
-- HP
--============================================================

local function getHealthPercent()

    local result = nil

    pcall(function()

        local playerGui = player:FindFirstChildOfClass("PlayerGui")

        if not playerGui then
            return
        end

        local hpDigits =
            playerGui
            :FindFirstChild("PlayerMain")
            :FindFirstChild("Dark")
            :FindFirstChild("StatHUD")
            :FindFirstChild("Health")
            :FindFirstChild("Digits")

        if hpDigits and hpDigits:IsA("TextLabel") then

            local currentStr, maxStr =
                hpDigits.Text:match("(%d+)[%s/]+(%d+)")

            if currentStr and maxStr then

                local currentHp = tonumber(currentStr)
                local maxHp = tonumber(maxStr)

                if currentHp and maxHp and maxHp > 0 then

                    result = (currentHp / maxHp) * 100

                end

            end

        end

    end)

    return result

end

