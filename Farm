-- =========================================================
-- LEVELDEN BOSS SEÇ
-- =========================================================

local function getBossForLevel(level)

    if not level then
        return nil
    end

    for _, route in ipairs(levelRoutes) do

        if level >= route.min
            and level <= route.max then

            return route.boss

        end

    end

    return nil
end

-- =========================================================
-- AUTO LEVEL KONTROL
-- =========================================================

local function updateAutoLevel()

    if not autoLevelEnabled then
        return
    end

    local level =
        getLevel()

    if not level then
        return
    end

    local targetBoss =
        getBossForLevel(level)

    if not targetBoss then
        return
    end

    if activeFarm ~= targetBoss then

        activeFarm = targetBoss
        healArmed = true

    end

end

task.spawn(function()

