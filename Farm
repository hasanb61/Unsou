local function getHealthPercent()

    local value

    pcall(function()

        local hp =
            player.PlayerGui
            .PlayerMain
            .Dark
            .StatHUD
            .Health
            .Digits

        local current, max =
            hp.Text:match("(%d+)[%s/]+(%d+)")

        if current and max then

            current = tonumber(current)
            max = tonumber(max)

            if max and max > 0 then
                value = (current / max) * 100
            end
        end

    end)

    return value
end

