task.spawn(function()
    while true do
        if activeFarm then
            local selectedFarm = activeFarm

            runBoss(selectedFarm)

            -- Secilen farm degismediyse sonraki dongüye gec
            if activeFarm == selectedFarm then
                if not farmStartTime then
                    farmStartTime = tick()
                end

                task.wait(0.5)
            end
        else
            task.wait(0.2)
        end
    end
end)
