local function getHealthPercent()
    local result = nil

    pcall(function()
        local hpDigits = player.PlayerGui.PlayerMain.Dark.StatHUD.Health.Digits

        if hpDigits and hpDigits:IsA("TextLabel") then
            local currentStr, maxStr = hpDigits.Text:match("(%d+)[%s/]+(%d+)")

            if currentStr and maxStr then
                local currentHp = tonumber(currentStr)
                local maxHp = tonumber(maxStr)

                if currentHp and maxHp and maxHp > 0 then
                    result = (currentHp / maxHp) * 100
                end
            end
        end
    end)

    return result
end

--==================================================
-- UNIVERSAL AUTO HEAL
-- Tum bosslarda: %50'de 4, %30 ve altinda 3.
-- Eski otoheal gibi: esyayi sec, alt taraftan kullan,
-- animasyon bitene kadar bekle, sonra kilica don.
--==================================================

local healing = false
local heal30Ready = true
local heal50Ready = true

local function doHeal(key, equipWait, castWait)
    if healing then
        return false
    end

    healing = true
    local ok, err = pcall(function()
        pressKey(key)
        task.wait(equipWait)

        local camera = workspace.CurrentCamera
        if not camera then
            error("CurrentCamera is unavailable")
        end

        local viewport = camera.ViewportSize
        local clickX = viewport.X / 2
        local clickY = viewport.Y - 100

        VIM:SendMouseButtonEvent(clickX, clickY, 0, true, game, 1)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(clickX, clickY, 0, false, game, 1)

        task.wait(castWait)
        equipSword()
        task.wait(3.5)
    end)

    healing = false

    if not ok then
        warn("Auto heal failed: " .. tostring(err))
        return false
    end

    return true
end

task.spawn(function()
    while true do
        task.wait(0.2)

        if activeFarm then
            local hp = getHealthPercent()

            if hp then
                if hp > 30 then
                    heal30Ready = true
                end
                if hp > 50 then
                    heal50Ready = true
                end

                if not healing then
                    if hp <= 30 and heal30Ready then
                        heal30Ready = false
                        heal50Ready = false
                        setStatus("HP <= 30%; using item 3")
                        doHeal(Enum.KeyCode.Three, 0.1, 1.5)
                        if activeFarm then
                            setStatus("Fighting " .. (farmConfigs[activeFarm] and farmConfigs[activeFarm].displayName or activeFarm))
                        end
                    elseif hp <= 50 and heal50Ready then
                        heal50Ready = false
                        setStatus("HP <= 50%; using item 4")
                        doHeal(Enum.KeyCode.Four, 0.5, 3)
                        if activeFarm then
                            setStatus("Fighting " .. (farmConfigs[activeFarm] and farmConfigs[activeFarm].displayName or activeFarm))
                        end
                    end
                end
            end
        else
            heal30Ready = true
            heal50Ready = true
        end
    end
end)

