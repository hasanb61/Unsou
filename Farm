local function holdCenterMouse()
    if heldMousePosition then
        return true
    end

    if userTouchingScreen then
        return false
    end

    local camera = workspace.CurrentCamera

    if not camera then
        return false
    end

    local viewport = camera.ViewportSize
    local position = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local succeeded, err = pcall(function()
        VIM:SendMouseButtonEvent(position.X, position.Y, 0, true, game, 1)
    end)

    if not succeeded then
        warn("Could not hold center mouse button: " .. tostring(err))
        return false
    end

    heldMousePosition = position
    return true
end

releaseHeldMouse = function()
    if not heldMousePosition then
        return true
    end

    local position = heldMousePosition
    local succeeded, err = pcall(function()
        VIM:SendMouseButtonEvent(position.X, position.Y, 0, false, game, 1)
    end)

    if not succeeded then
        warn("Could not release held mouse button: " .. tostring(err))
        return false
    end

    heldMousePosition = nil
    return true
end

local function releaseHeldInputs()
