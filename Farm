local serversLoadToken = 0

local function loadServersList()
    serversLoadToken = serversLoadToken + 1
    local thisLoadToken = serversLoadToken

    for _, child in ipairs(serversScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local loadingLabel = Instance.new("TextLabel")
    loadingLabel.Size = UDim2.new(1, -4, 0, 30)
    loadingLabel.BackgroundTransparency = 1
    loadingLabel.TextColor3 = Color3.fromRGB(190, 190, 200)
    loadingLabel.TextSize = 12
    loadingLabel.Font = Enum.Font.Gotham
    loadingLabel.Text = "Sunucular yükleniyor..."
    loadingLabel.Parent = serversScroll

    task.spawn(function()
        local placeId = game.PlaceId
        local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100"

        local success, response = pcall(function()
            local body = game:HttpGet(url)
            return HttpService:JSONDecode(body)
        end)

        if thisLoadToken ~= serversLoadToken then
            return
        end

        loadingLabel:Destroy()

        if not success or not response or type(response.data) ~= "table" then
            local errorLabel = Instance.new("TextLabel")
            errorLabel.Size = UDim2.new(1, -4, 0, 42)
            errorLabel.BackgroundTransparency = 1
            errorLabel.TextColor3 = Color3.fromRGB(235, 150, 150)
            errorLabel.TextSize = 12
            errorLabel.Font = Enum.Font.Gotham
            errorLabel.TextWrapped = true
            errorLabel.Text = "Sunucu listesi alınamadı. HTTP isteği desteklenmiyor olabilir."
            errorLabel.Parent = serversScroll
            return
        end

        if #response.data == 0 then
            local emptyLabel = Instance.new("TextLabel")
            emptyLabel.Size = UDim2.new(1, -4, 0, 30)
            emptyLabel.BackgroundTransparency = 1
            emptyLabel.TextColor3 = Color3.fromRGB(190, 190, 200)
            emptyLabel.TextSize = 12
            emptyLabel.Font = Enum.Font.Gotham
            emptyLabel.Text = "Listelenecek sunucu bulunamadı."
            emptyLabel.Parent = serversScroll
            return
        end

        for index, server in ipairs(response.data) do
            local isCurrentServer = server.id == game.JobId

            local item = Instance.new("Frame")
            item.Name = "ServerRow_" .. tostring(index)
            item.Size = UDim2.new(1, -4, 0, 38)
            item.BackgroundColor3 = isCurrentServer
                and Color3.fromRGB(40, 80, 40)
                or Color3.fromRGB(35, 35, 42)
            item.BorderSizePixel = 0
            item.LayoutOrder = index
            item.Parent = serversScroll

            local itemCorner = Instance.new("UICorner")
            itemCorner.CornerRadius = UDim.new(0, 6)
            itemCorner.Parent = item

            local infoText = Instance.new("TextLabel")
            infoText.Size = UDim2.new(0.67, 0, 1, 0)
            infoText.Position = UDim2.new(0, 9, 0, 0)
            infoText.BackgroundTransparency = 1
            infoText.TextColor3 = Color3.fromRGB(245, 245, 250)
            infoText.TextXAlignment = Enum.TextXAlignment.Left
            infoText.Font = Enum.Font.Gotham

            local pingValue = tonumber(server.ping)
            local pingText = pingValue
                and (tostring(math.floor(pingValue)) .. " ms")
                or "? ms"

            infoText.TextSize = 11
            infoText.Text = string.format(
                "%s  %d/%d oyuncu  •  %s",
                isCurrentServer and "●" or "○",
                tonumber(server.playing) or 0,
                tonumber(server.maxPlayers) or 0,
                pingText
            )
            infoText.Parent = item

            local joinButton = Instance.new("TextButton")
            joinButton.Size = UDim2.new(0.27, 0, 0.72, 0)
            joinButton.Position = UDim2.new(0.70, 0, 0.14, 0)
            joinButton.BackgroundColor3 = isCurrentServer
                and Color3.fromRGB(65, 95, 65)
                or Color3.fromRGB(0, 120, 215)
            joinButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            joinButton.Text = isCurrentServer and "Buradasın" or "Katıl"
            joinButton.TextSize = 11
            joinButton.Font = Enum.Font.GothamBold
            joinButton.Parent = item

            local joinCorner = Instance.new("UICorner")
            joinCorner.CornerRadius = UDim.new(0, 5)
            joinCorner.Parent = joinButton

            if not isCurrentServer then
                local serverId = server.id

                joinButton.MouseButton1Click:Connect(function()
                    joinButton.Text = "Gidiliyor..."
                    joinButton.Active = false

                    local teleportSuccess = pcall(function()
                        TeleportService:TeleportToPlaceInstance(placeId, serverId, player)
                    end)

                    if not teleportSuccess and joinButton.Parent then
                        joinButton.Text = "Tekrar dene"
                        joinButton.Active = true
                    end
                end)
            else
                joinButton.Active = false
            end
        end
    end)
end

