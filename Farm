--========================================================--
-- TELEPORT
--========================================================--

local function teleportTo(cframe)

    pcall(function()

        local character = player.Character

        if not character then
            return
        end

        local root =
            character:FindFirstChild("HumanoidRootPart")

        if root then

            root.AssemblyLinearVelocity =
                Vector3.new(0, 0, 0)

            root.CFrame = cframe

        end

    end)

end

