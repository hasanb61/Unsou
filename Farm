local function nameMatches(objName, target, prefix)
    if objName == target then
        return true
    end

    if prefix then
        return string.lower(string.sub(objName, 1, #target)) == string.lower(target)
    end

    return false
end

local function findBossModel(bossName, prefix)
    local activeBosses = workspace:FindFirstChild("ActiveBosses")

    if not activeBosses then
        return nil
    end

    for _, slot in ipairs(activeBosses:GetChildren()) do
        local bossesFolder = slot:FindFirstChild("Bosses")

        if bossesFolder then
            for _, obj in ipairs(bossesFolder:GetDescendants()) do
                if obj:IsA("Model") and nameMatches(obj.Name, bossName, prefix) then
                    return obj
                end
            end
        end
    end

    return nil
end

local function findClosestBossModel(bossName, fromPosition)
    local activeBosses = workspace:FindFirstChild("ActiveBosses")

    if not activeBosses then
        return nil
    end

    local closestBoss = nil
    local closestDistance = math.huge

    for _, slot in ipairs(activeBosses:GetChildren()) do
        local bossesFolder = slot:FindFirstChild("Bosses")

        if bossesFolder then
            for _, object in ipairs(bossesFolder:GetDescendants()) do
                if object:IsA("Model") and object.Name == bossName then
                    local distance = (object:GetPivot().Position - fromPosition).Magnitude

                    if distance < closestDistance then
                        closestBoss = object
                        closestDistance = distance
                    end
                end
            end
        end
    end

    return closestBoss
end

local function getWatercoolerPartPosition(boss, partNames)
    for _, partName in ipairs(partNames) do
        local target = boss:FindFirstChild(partName, true)

        if target then
            if target:IsA("BasePart") then
                return target.Position
            elseif target:IsA("Attachment") then
                return target.WorldPosition
            elseif target:IsA("Vector3Value") then
                return target.Value
            elseif target:IsA("CFrameValue") then
                return target.Value.Position
            elseif target:IsA("ObjectValue") and target.Value then
                local value = target.Value

                if value:IsA("BasePart") then
                    return value.Position
                elseif value:IsA("Attachment") then
                    return value.WorldPosition
                elseif value:IsA("Vector3Value") then
                    return value.Value
                elseif value:IsA("CFrameValue") then
                    return value.Value.Position
                elseif value:IsA("Model") then
                    return value:GetPivot().Position
                end
            end
        end
    end

    return boss:GetPivot().Position
end

getWatercoolerAimPosition = function(boss)
    return getWatercoolerPartPosition(boss, {"TargetTo", "Head", "Hitbox", "Torso"})
end

local function isBossModelActive(boss)
    if not boss then
        return false
    end

    local activeBosses = workspace:FindFirstChild("ActiveBosses")
    local ancestor = boss

    while ancestor and ancestor.Parent ~= activeBosses do
        ancestor = ancestor.Parent
    end

    return ancestor ~= nil
        and activeBosses ~= nil
        and ancestor.Parent == activeBosses
end

