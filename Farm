    button.BackgroundColor3 = Color3.fromRGB(25, 26, 34)
    button.BorderSizePixel = 0
    button.Text = bossDisplay[name] .. "\n[KAPALI]"
    button.TextColor3 = Color3.fromRGB(190, 190, 200)
    button.TextSize = 10
    button.Font = Enum.Font.GothamBold
