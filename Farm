local function findOffHeadSlot()
    local activeBosses = workspace:FindFirstChild("ActiveBosses")

    if not activeBosses then
        return nil
    end

    for _, slot in ipairs(activeBosses:GetChildren()) do
        local bossesFolder = slot:FindFirstChild("Bosses")

        if bossesFolder then
            for _, obj in ipairs(bossesFolder:GetDescendants()) do
                local n = string.lower(tostring(obj.Name))

                if n == "oof head" or n == "oofhead" or n == "oof_head" then
                    return slot
                end
            end
        end
    end

    return nil
end

local function offHeadSlotExists(slot)
    if not slot then
        return false
    end

    local activeBosses = workspace:FindFirstChild("ActiveBosses")

    if not activeBosses then
        return false
    end

    return slot.Parent == activeBosses
end

