local function setButtonState(
    farmName,
    isOn
)

    local button =
        bossButtons[farmName]

    if not button then
        return
    end

    local config =
        farmConfigs[farmName]

    if isOn then

        button.Text =
            config.displayName ..
            " [AÇIK]"

        button.BackgroundColor3 =
            ON_COLOR

        button.TextColor3 =
            ON_TEXT

    else

        button.Text =
            config.displayName ..
            " [KAPALI]"

        button.BackgroundColor3 =
            OFF_COLOR

        button.TextColor3 =
            OFF_TEXT
    end
end

