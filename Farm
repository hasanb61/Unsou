--========================================================--
-- ANA FARM
--========================================================--

task.spawn(function()

    while true do

        if not activeFarm then

            task.wait(0.5)

        else

            local farmName =
                activeFarm

            local config =
                farmConfigs[farmName]

            if not config then

                task.wait(0.5)

            else

                currentlyFarming =
                    farmName

                --========================================
                -- PORTALA GİR
                --========================================

                teleportTo(
                    portals[farmName]
                )

                --========================================
                -- 5 SANİYE SHIELD
                --========================================

                local shieldStart =
                    tick()

                while
                    activeFarm == farmName
                    and
                    tick() - shieldStart < 5
                do

                    task.wait(0.1)

                end

                --========================================
                -- FARM
                --========================================

                if activeFarm == farmName then

                    -- Susportal özel yetenek
                    if config.special then

                        useSpecialAbility()

                    end

                    --====================================
                    -- BOSS BEKLE
                    --====================================

                    local boss =
                        waitForBoss(
                            config.bossName
                        )

                    if boss
                        and
                        activeFarm == farmName then

                        --================================
                        -- AUTO CLICK LOOP
                        --
                        -- NORMALDE 1'E BASILMIYOR
                        --
                        -- SADECE HEAL'DEN SONRA
                        -- BOB/SUSPORTAL'DA 1 BASILIYOR.
                        --================================

                        while
                            activeFarm == farmName
                        do

                            -- Auto level threshold değiştiyse
                            if autoLevelEnabled then

                                local correctBoss =
                                    getAutoBoss()

                                if correctBoss
                                    ~= farmName then

                                    break

                                end

                            end

                            -- Boss hâlâ var mı?
                            local currentBoss =
                                findBossModel(
                                    config.bossName
                                )

                            -- Yoksa boss öldü
                            if not currentBoss then

                                break

                            end

                            -- Mevcut eldeki kılıçla
                            -- sadece click gönder
                            clickCenter()

                            task.wait(0.10)

                        end

                    end

                end

                --========================================
                -- BOSS ÖLDÜ
                --========================================

                if activeFarm == farmName then

                    task.wait(2)

                    teleportTo(
                        safePosition
                    )

                    task.wait(0.2)

                end

                currentlyFarming = nil

            end

        end

    end

end)
