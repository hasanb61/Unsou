local function getLevel()

    local result

    pcall(function()

        local leaderstats =
            player:FindFirstChild("leaderstats")

        if leaderstats then

            local lv =
                leaderstats:FindFirstChild("LV")

            if lv then
                result = tonumber(lv.Value)
            end
        end
    end)

    return result or 0
end

--==================================================
-- LEVEL → BOSS
--==================================================

local function getBossForLevel(level)

    if level >= 5500 then
        return "Outertale"

    elseif level >= 4900 then
        return "Hyperdust"

    elseif level >= 3985 then
        return "Bob"

    elseif level >= 3250 then
        return "OffHead"

    elseif level >= 1600 then
        return "Undyne"

    elseif level >= 305 then
        return "Susportal"
    end

    return nil
end

