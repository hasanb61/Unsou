--// =========================================================
--// ANA FARM DÖNGÜSÜ
--// =========================================================

task.spawn(function()

    while true do

        if not activeFarm then

            task.wait(0.5)

        else

            local farmName =
                activeFarm

            local config =
                farmConfigs[farmName]

            if not config then

                task.wait(0.5)

            else

                local portalCFrame =
                    portals[farmName]

                --===========================================
                -- PORTALA IŞINLAN
                --===========================================

                pcall(function()

                    local character =
                        player.Character

                    if character then

                        local root =
                            character:FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if root then

                            root.AssemblyLinearVelocity =
                                Vector3.new(0, 0, 0)

                            root.CFrame =
                                portalCFrame

                        end

                    end

                end)

                --===========================================
                -- 5 SANİYE SHIELD
                --===========================================

                local shieldTime = 0

                while shieldTime < 5
                    and activeFarm == farmName do

                    task.wait(0.5)

                    shieldTime =
                        shieldTime + 0.5

                end

                --===========================================
                -- SPECIAL
                --===========================================

                if activeFarm == farmName
                    and config.special then

                    useSpecialAbility()

                end

                if activeFarm ~= farmName then
                    continue
                end

                --===========================================
                -- GERÇEK BOSS'U BEKLE
                --===========================================

                local boss =
                    waitForBoss(
                        config.bossName
                    )

                if not boss then
                    continue
                end

                --===========================================
                -- SALDIRI
                --===========================================

                while activeFarm == farmName do

                    -- Auto Level başka boss'a geçtiyse
                    if autoLevelEnabled then

                        local newTarget =
                            getAutoBoss()

                        if newTarget
                            and newTarget ~= farmName then

                            break

                        end

                    end

                    -- Boss gerçekten hâlâ var mı?
                    local currentBoss =
                        findBossModel(
                            config.bossName
                        )

                    if not currentBoss then

                        -- Boss öldü
                        break

                    end

                    -- 📱 KULLANICI DOKUNUYORSA
                    -- clickCenter hiçbir şey yapmaz.
                    --
                    -- Parmağını çekince otomatik
                    -- olarak yeniden tıklamaya başlar.
                    clickCenter()

                    task.wait(0.10)

                end

                --===========================================
                -- BOSS ÖLDÜKTEN SONRA 2 SANİYE
                --===========================================

                if activeFarm == farmName then

                    task.wait(2)

                    --=======================================
                    -- SAFE AREA
                    --=======================================

                    pcall(function()

                        local character =
                            player.Character

                        if character then

                            local root =
                                character:FindFirstChild(
                                    "HumanoidRootPart"
                                )

                            if root then

                                root.AssemblyLinearVelocity =
                                    Vector3.new(0, 0, 0)

                                root.CFrame =
                                    safePosition

                            end

                        end

                    end)

                    task.wait(0.2)

                end

            end

        end

    end

end)

