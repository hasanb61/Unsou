local function getHealthPercent()

    local result = nil

    pcall(function()

        local hpDigits =
            player.PlayerGui
            .PlayerMain
            .Dark
            .StatHUD
            .Health
            .Digits

        if hpDigits and hpDigits:IsA("TextLabel") then

            local currentStr, maxStr =
                hpDigits.Text:match(
                    "(%d+)[%s/]+(%d+)"
                )

            if currentStr and maxStr then

                local currentHp =
                    tonumber(currentStr)

                local maxHp =
                    tonumber(maxStr)

                if currentHp
                    and maxHp
                    and maxHp > 0 then

                    result =
                        (currentHp / maxHp) * 100
                end
            end
        end

    end)

    return result
end

