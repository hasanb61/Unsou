-- =========================================================
-- AUTO CLICK
-- =========================================================

local function attackBoss(bossModel, bossName)

    if not bossModel then
        return false
    end

    local bossWasSeen = true

    while activeFarm do

        local currentBoss =
            findBossModel(bossName)

        -- Boss model gerçekten yok oldu
        if not currentBoss then

            if bossWasSeen then
                return true
            end

            task.wait(0.1)

        else

            bossWasSeen = true

            -- Kullanıcı ekrana dokunuyorsa
            -- auto click durur.
            if not userTouchingScreen then
                clickCenter()
            end

            task.wait(0.1)

        end
    end

    return false
end

-- =========================================================
-- ÖZEL YETENEK SONRASI BOSS DURUMU
-- =========================================================

local function handleSpecialAndBoss(config)

    if not activeFarm then
        return
    end

    -- Özel yetenekten ÖNCE bossu gör
    local bossBefore =
        findBossModel(config.bossName)

    -- Bob hariç herkes 5 kullanıyor
    if config.special then

        useSpecialAbility()

        -- Her özel yetenekten sonra tekrar kılıca geç
        equipSword()

        task.wait(0.15)

        -- 5 bossu direkt öldürdüyse
        -- model artık bulunmayabilir.
        if bossBefore then

            local bossAfter =
                findBossModel(config.bossName)

            if not bossAfter then

                registerKill(activeFarm)
                return

            end
        end
    else

        -- Bob'da özel yetenek yok.
        -- Direkt kılıç.
        equipSword()

    end

    -- Boss zaten mevcutsa onu kullan
    local boss =
        findBossModel(config.bossName)

    -- Boss henüz bulunmuyorsa kısa süre bekle
    if not boss then

        boss =
            waitForBoss(
                config.bossName,
                10
            )

    end

    if not boss then

        -- Özel yetenek sırasında öldüyse
        -- son bir kez kontrol.
        if not findBossModel(config.bossName) then

            if bossBefore then
                registerKill(activeFarm)
            end

        end

        return
    end

    -- Normal kılıç auto-click
    local killed =
        attackBoss(
            boss,
            config.bossName
        )

    if killed and activeFarm then
        registerKill(activeFarm)
    end
end

