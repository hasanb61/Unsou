local function getActiveBosses()

    return workspace:FindFirstChild("ActiveBosses")

end

--========================================================--
-- BOSS MODEL BUL
--========================================================--

local function findBossModel(bossName)

    local activeBosses = getActiveBosses()

    if not activeBosses then
        return nil
    end

    for _, slot in ipairs(
        activeBosses:GetChildren()
    ) do

        local bossesFolder =
            slot:FindFirstChild("Bosses", true)

        if bossesFolder then

            for _, object in ipairs(
                bossesFolder:GetDescendants()
            ) do

                if object:IsA("Model")
                    and object.Name == bossName then

                    return object

                end

            end

        end

    end

    return nil

end

--========================================================--
-- BOSS BEKLE
--========================================================--

local function waitForBoss(bossName)

    while activeFarm ~= nil do

        local boss =
            findBossModel(bossName)

        if boss then
            return boss
        end

        task.wait(0.15)

    end

    return nil

end

--========================================================--
-- LEVEL
--========================================================--

local function getPlayerLevel()

    local leaderstats =
        player:FindFirstChild("leaderstats")

    if not leaderstats then
        return 0
    end

    local level =
        leaderstats:FindFirstChild("LV")

    if not level then
        return 0
    end

    return tonumber(level.Value) or 0

end

--========================================================--
-- AUTO LEVEL
--========================================================--

local function getAutoBoss()

    local level =
        getPlayerLevel()

    if level >= 5500 then

        return "Outertale"

    elseif level >= 4900 then

        return "Hyperdust"

    elseif level >= 3985 then

        return "Bob"

    elseif level >= 3250 then

        return "OffHead"

    elseif level >= 1600 then

        return "Undyne"

    elseif level >= 305 then

        return "Susportal"

    end

    return nil

end

--========================================================--
-- HP OKUMA
--========================================================--

local function getHealthPercent()

    local success, result =
        pcall(function()

            local hpDigits =
                player.PlayerGui
                    .PlayerMain
                    .Dark
                    .StatHUD
                    .Health
                    .Digits

            if not hpDigits then
                return nil
            end

            if not hpDigits:IsA("TextLabel") then
                return nil
            end

            local current, maximum =
                hpDigits.Text:match(
                    "(%d+)[%s/]+(%d+)"
                )

            if not current or not maximum then
                return nil
            end

            current = tonumber(current)
            maximum = tonumber(maximum)

            if not current
                or not maximum
                or maximum <= 0 then

                return nil

            end

            return (current / maximum) * 100

        end)

    if success then
        return result
    end

    return nil

end

