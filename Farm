-- GERÇEK BOSS MODELİNİ BUL
--==================================================

local function findBossModel(bossName)

    local activeBosses =
        workspace:FindFirstChild("ActiveBosses")

    if not activeBosses then
        return nil
    end

    for _, slot in ipairs(activeBosses:GetChildren()) do

        local bossesFolder =
            slot:FindFirstChild("Bosses")

        if bossesFolder then

            local directBoss =
                bossesFolder:FindFirstChild(bossName)

            if directBoss and directBoss:IsA("Model") then
                return directBoss
            end

            for _, obj in ipairs(
                bossesFolder:GetDescendants()
            ) do

                if obj:IsA("Model")
                    and obj.Name == bossName then

                    return obj
                end

            end
        end
    end

    return nil
end

--==================================================
-- OFF HEAD ÖZEL SLOT BULMA
-- Yapı: ActiveBosses > SlotX > Bosses > 1 > OOF head
-- Combat Undyne ile aynı kalır; sadece ölüm algısı özeldir.
--==================================================

local function findOffHeadSlot()
    local activeBosses = workspace:FindFirstChild("ActiveBosses")

    if not activeBosses then
        return nil
    end

    for _, slot in ipairs(activeBosses:GetChildren()) do
        local bossesFolder = slot:FindFirstChild("Bosses")

        if bossesFolder then
            for _, obj in ipairs(bossesFolder:GetDescendants()) do
                if string.lower(tostring(obj.Name)) == "oof head"
                    or string.lower(tostring(obj.Name)) == "oofhead"
                    or string.lower(tostring(obj.Name)) == "oof_head" then

                    return slot
                end
            end
        end
    end

    return nil
end

local function offHeadSlotExists(slot)
    if not slot then
        return false
    end

    local activeBosses = workspace:FindFirstChild("ActiveBosses")

    if not activeBosses then
        return false
    end

    return slot.Parent == activeBosses
end

