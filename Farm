local function teleportTo(cframe)

    pcall(function()

        local character =
            player.Character

        if not character then
            return
        end

        local root =
            character:FindFirstChild("HumanoidRootPart")

        if not root then
            return
        end

        root.AssemblyLinearVelocity =
            Vector3.new(0, 0, 0)

        root.CFrame = cframe

    end)

end

-- =========================================================
-- HP OKUMA
-- =========================================================

local function getHealthPercent()

    local success, result =
        pcall(function()

            local playerGui =
                player:FindFirstChildOfClass(
                    "PlayerGui"
                )

            if not playerGui then
                return nil
            end

            local playerMain =
                playerGui:FindFirstChild(
                    "PlayerMain"
                )

            if not playerMain then
                return nil
            end

            local dark =
                playerMain:FindFirstChild("Dark")

            if not dark then
                return nil
            end

            local statHUD =
                dark:FindFirstChild("StatHUD")

            if not statHUD then
                return nil
            end

            local health =
                statHUD:FindFirstChild("Health")

            if not health then
                return nil
            end

            local digits =
                health:FindFirstChild("Digits")

            if not digits then
                return nil
            end

            local text =
                tostring(digits.Text)

            local currentStr, maxStr =
                text:match(
                    "(%d+)[%s/]+(%d+)"
                )

            if not currentStr
                or not maxStr then

                return nil
            end

            local currentHp =
                tonumber(currentStr)

            local maxHp =
                tonumber(maxStr)

            if not currentHp
                or not maxHp
                or maxHp <= 0 then

                return nil
            end

            return (currentHp / maxHp) * 100

        end)

    if success then
        return result
    end

    return nil
end

-- =========================================================
-- HEAL
-- =========================================================

local function performHeal()

    if not activeFarm then
        return
    end

    local config =
        farmConfigs[activeFarm]

    if not config
        or not config.heal then

        return
    end

    if not healArmed then
        return
    end

    healArmed = false

    -- 3
    pressKey(Enum.KeyCode.Three)

    task.wait(0.05)

    -- Alt tarafa click
    pcall(function()

        local camera =
            workspace.CurrentCamera

        if not camera then
            return
        end

        local viewportSize =
            camera.ViewportSize

        local clickX =
            viewportSize.X / 2

        local clickY =
            viewportSize.Y - 100

        vim:SendMouseButtonEvent(
            clickX,
            clickY,
            0,
            true,
            game,
            1
        )

        task.wait(0.05)

        vim:SendMouseButtonEvent(
            clickX,
            clickY,
            0,
            false,
            game,
            1
        )

    end)

    task.wait(0.3)

    equipSword()

    task.wait(1)
end

-- =========================================================
-- HEAL THREAD
-- =========================================================

task.spawn(function()

    while true do

        task.wait(0.2)

        if activeFarm then

            local config =
                farmConfigs[activeFarm]

            if config
                and config.heal then

                local hp =
                    getHealthPercent()

                if hp then

                    if hp <= 30 then
                        performHeal()

                    elseif hp > 30 then
                        healArmed = true
                    end

                end
            end
        else
            healArmed = true
        end
    end
end)

