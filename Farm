task.spawn(function()

    while true do

        if activeFarm then

            local farmName =
                activeFarm

            local config =
                farmConfigs[farmName]

            if config then

                -- 1. PORTALA GİT
                teleportTo(config.portal)

                -- 2. SHIELD / GÜVENLİK BEKLEMESİ
                local shieldTime = 0

                while shieldTime < 6
                    and activeFarm == farmName do

                    task.wait(0.5)

                    shieldTime += 0.5

                end

                -- 3. BOSS SİSTEMİ
                if activeFarm == farmName then

                    handleSpecialAndBoss(config)

                end

                -- 4. BOSS ÖLDÜKTEN SONRA SAFE
                if activeFarm == farmName then

                    teleportTo(safePosition)

                    task.wait(2)

                end

            end

        else

            task.wait(0.2)

        end

    end

end)

