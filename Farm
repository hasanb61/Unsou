--==================================================
-- BOSS AKTİFLEŞTİR
--==================================================

local function activateFarm(farmName)

    autoLevel = false
    setAutoLevelState(false)

    if activeFarm == farmName then

        pauseFarmTimer()
        activeFarm = nil
        farmStartTime = nil
        farmNeedsTeleport = true
        setStatus("Farm durduruldu")

        resetBossButtons()

        return
    end

    if activeFarm and farmStartTime then
        pauseFarmTimer()
    end

    activeFarm = farmName
    farmNeedsTeleport = true
    resumeFarmTimer()
    setStatus(
        farmConfigs[farmName].displayName
        .. " seçildi; portal bekleniyor"
    )

    resetBossButtons()

    setButtonState(
        farmName,
        true
    )
end

