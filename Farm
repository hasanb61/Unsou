--==================================================

local function goSafe()

    pcall(function()

        local char = player.Character
        local root =
            char and char:FindFirstChild("HumanoidRootPart")

        if root then

            root.AssemblyLinearVelocity =
                Vector3.new(0, 0, 0)

            root.CFrame = safePosition
        end
    end)
end

--==================================================
-- BOSS FARM
--==================================================

local function runBoss(farmName)

    local config = farmConfigs[farmName]

    if not config then
        return
    end

    local portal = portals[farmName]

    if not portal then
        return
    end

    --==============================================
    -- PORTALA GİT
    --==============================================

    pcall(function()

        local char = player.Character
        local root =
            char and char:FindFirstChild("HumanoidRootPart")

        if root then

            root.AssemblyLinearVelocity =
                Vector3.new(0, 0, 0)

            root.CFrame = portal
        end
    end)

    --==============================================
    -- 6 SANİYE SHIELD
    --==============================================

    for i = 1, 12 do

        if activeFarm ~= farmName then
            return
        end

        task.wait(0.5)
    end

    if activeFarm ~= farmName then
        return
    end

    --==============================================
    -- BOSSU ÖNCEDEN AL
    --==============================================

    local bossBeforeSpecial =
        findBossModel(config.bossName)

    --==============================================
    -- UNDYNE İLE AYNI MANTIK
    -- 5 → 1 → NORMAL ATAK
    --==============================================

    if config.special then

        useSpecialAbility()

        if activeFarm ~= farmName then
            return
        end

        -- Özel yetenekten sonra MUTLAKA 1
        equipSword()

        task.wait(0.15)
    else

        -- Bob gibi 5 kullanmayanlar
        equipSword()
    end

    --==============================================
    -- 5 BOSSU TEK BAŞINA ÖLDÜRDÜYSE
    --==============================================

    if bossBeforeSpecial then

        if not findBossModel(config.bossName) then

            registerKill(farmName)

            task.wait(2)

            goSafe()

            return
        end
    end

    --==============================================
    -- BOSSUN ORTAYA ÇIKMASINI BEKLE
    --==============================================

    local boss = findBossModel(config.bossName)

    local waitStart = tick()

    while not boss
        and activeFarm == farmName
        and tick() - waitStart < 60 do

        task.wait(0.15)

        boss = findBossModel(config.bossName)
    end

    if activeFarm ~= farmName then
        return
    end

    --==============================================
    -- BOSS GERÇEKTEN VARSA AUTO CLICK
    --==============================================

    local lastAttack = 0

    while activeFarm == farmName do

        boss = findBossModel(config.bossName)

        -- MODEL YOKSA = GERÇEK BOSS ÖLDÜ
        if not boss then

            registerKill(farmName)

            task.wait(2)

            goSafe()

            return
        end

        -- Normal saldırı
        if tick() - lastAttack >= 0.10 then

            centerClick()

            lastAttack = tick()
        end

        task.wait(0.03)
    end
end

