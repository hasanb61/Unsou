        return
    end

    pcall(function()

        local camera = workspace.CurrentCamera

        if not camera then
            return
        end

        local viewportSize = camera.ViewportSize

        local clickX = viewportSize.X / 2
        local clickY = viewportSize.Y / 2

        VirtualInputManager:SendMouseButtonEvent(
            clickX,
            clickY,
            0,
            true,
            game,
            1
        )

        task.wait(0.02)

        VirtualInputManager:SendMouseButtonEvent(
            clickX,
            clickY,
            0,
            false,
            game,
            1
        )

    end)

end

