    refButton.TextSize = 9
    refButton.Font = Enum.Font.GothamBold
    refButton.Parent = box

    local refCorner = Instance.new("UICorner")
    refCorner.CornerRadius = UDim.new(0, 7)
    refCorner.Parent = refButton

    local targetButton = Instance.new("TextButton")
    targetButton.Size = UDim2.new(0, 70, 0, 30)
    targetButton.Position = UDim2.new(0, 190, 0, 35)
    targetButton.BackgroundColor3 = Color3.fromRGB(32, 33, 42)
    targetButton.BorderSizePixel = 0
    targetButton.Text = "5 DK"
    targetButton.TextColor3 = Color3.fromRGB(220, 220, 225)
    targetButton.TextSize = 9
    targetButton.Font = Enum.Font.GothamBold
    targetButton.Parent = box

    local targetCorner = Instance.new("UICorner")
    targetCorner.CornerRadius = UDim.new(0, 7)
    targetCorner.Parent = targetButton

    local result = Instance.new("TextLabel")
    result.Size = UDim2.new(0, 90, 0, 30)
    result.Position = UDim2.new(0, 268, 0, 35)
    result.BackgroundTransparency = 1
    result.Text = "≈ 0"
    result.TextColor3 = Color3.fromRGB(255, 255, 255)
    result.TextSize = 10
    result.Font = Enum.Font.GothamBold
    result.TextXAlignment = Enum.TextXAlignment.Left
    result.Parent = box

    local refIndex = 1
    local targetIndex = 1

    local durationList = {
        "5 DK",
        "10 DK",
        "30 DK",
        "1 SA"
    }

    local function calculate()

        local amount = tonumber(amountBox.Text)

        if not amount then

            result.Text = "≈ 0"
            return

        end

        local refText = durationList[refIndex]
        local targetText = durationList[targetIndex]

        local refMinutes = durations[refText]
        local targetMinutes = durations[targetText]

        local projected =
            amount / refMinutes * targetMinutes

        result.Text =
            "≈ " .. formatNumber(projected)

    end

    refButton.MouseButton1Click:Connect(function()

        refIndex += 1

        if refIndex > #durationList then
            refIndex = 1
        end

        refButton.Text = durationList[refIndex]

        calculate()

    end)

    targetButton.MouseButton1Click:Connect(function()

        targetIndex += 1

        if targetIndex > #durationList then
            targetIndex = 1
        end

        targetButton.Text = durationList[targetIndex]

        calculate()

    end)

    amountBox.FocusLost:Connect(function()

        calculate()

    end)

end

