--// =========================================================
--// BOSS MODEL BUL
--// ActiveBosses > Slot > Bosses
--// =========================================================

local function findBossModel(bossName)

    local activeBosses = workspace:FindFirstChild("ActiveBosses")

    if not activeBosses then
        return nil
    end

    for _, slot in ipairs(activeBosses:GetChildren()) do

        local bossesFolder =
            slot:FindFirstChild("Bosses", true)

        if bossesFolder then

            for _, object in ipairs(bossesFolder:GetDescendants()) do

                if object:IsA("Model")
                    and object.Name == bossName then

                    return object

                end

            end

        end

    end

    return nil

end

--// =========================================================
--// BOSS BEKLE
--// =========================================================

local function waitForBoss(bossName)

    while activeFarm ~= nil do

        local boss = findBossModel(bossName)

        if boss then
            return boss
        end

        task.wait(0.2)

    end

    return nil

end

