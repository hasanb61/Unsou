--==================================================
-- FORMAT TIME
--==================================================

local function formatTime(seconds)

    seconds =
        math.floor(seconds)

    local hours =
        math.floor(seconds / 3600)

    local minutes =
        math.floor(
            (seconds % 3600) / 60
        )

    local secs =
        seconds % 60

    return string.format(
        "%02d:%02d:%02d",
        hours,
        minutes,
        secs
    )
end

