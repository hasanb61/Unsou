local function getLeaderstat(name)

    local leaderstats =
        player:FindFirstChild("leaderstats")

    if not leaderstats then
        return nil
    end

    return leaderstats:FindFirstChild(name)
end

local function updateLiveStats()

    pcall(function()

        local level =
            getLeaderstat("LV")

        if level then
            levelValue.Text =
                "LV " .. tostring(level.Value)
        else
            levelValue.Text =
                "LV --"
        end

        local gold =
            getLeaderstat("Gold")

        if gold then
            goldValue.Text =
                tostring(gold.Value)
        else
            goldValue.Text =
                "0"
        end

    end)
end

-- =========================================================
-- SÜRE FORMAT
-- =========================================================

local function formatTime(seconds)

    seconds =
        math.max(0, math.floor(seconds))

    local hours =
        math.floor(seconds / 3600)

    local minutes =
        math.floor((seconds % 3600) / 60)

    local secs =
        seconds % 60

    return string.format(
        "%02d:%02d:%02d",
        hours,
        minutes,
        secs
    )
end

