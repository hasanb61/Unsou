local function registerKill(farmName)

    totalKills += 1

    if kills[farmName] ~= nil then
        kills[farmName] += 1
    end
end

--==================================================
-- SAFE
--==================================================

local function goSafe()

    pcall(function()

        local char =
            player.Character

        local root =
            char and
            char:FindFirstChild(
                "HumanoidRootPart"
            )

        if root then

            root.AssemblyLinearVelocity =
                Vector3.new(0, 0, 0)

            root.CFrame =
                safePosition
        end
    end)
end

local function teleportToPortal(portal, farmName)
    if activeFarm ~= farmName then
        return false
    end

    local succeeded, err =
        pcall(function()
            local character = player.Character

            if not character then
                character = player.CharacterAdded:Wait()
            end

            local root =
                character:WaitForChild(
                    "HumanoidRootPart",
                    10
                )

            if not root or activeFarm ~= farmName then
                return false
            end

            root.AssemblyLinearVelocity =
                Vector3.new(0, 0, 0)

            root.CFrame = portal
            return true
        end)

    if not succeeded then
        warn("Portal teleport failed: " .. tostring(err))
        return false
    end

    return err == true
end

--==================================================
-- BOSS FARM
--==================================================

local function runBoss(
    farmName
)

    if activeFarm ~= farmName then
        return
    end

    local config =
        farmConfigs[farmName]

    if not config then
        setStatus("Farm ayarı bulunamadı")
        return
    end

    local bossBeforeSpecial = nil
    local offHeadSlot = nil

    --==============================================
    -- PORTALA GİT (SADECE BOSS YOKSA)
    --==============================================

    local bossAlreadyPresent = false

    if config.offHeadDeathBySlot then
        bossAlreadyPresent = findOffHeadSlot() ~= nil
    else
        bossAlreadyPresent = findBossModel(config.bossName) ~= nil
    end

    if farmNeedsTeleport or not bossAlreadyPresent then
        setStatus(
            config.displayName .. " portalına ışınlanıyor"
        )

        local teleported =
            teleportToPortal(
                config.portal,
                farmName
            )

        if activeFarm ~= farmName then
            return
        end

        if not teleported then
            farmNeedsTeleport = true
            setStatus("Teleport başarısız; yeniden denenecek")
            task.wait(1)
            return
        end
    end

    setStatus("Kalkan için 6 saniye bekleniyor")

    --==============================================
    -- 6 SANİYE SHIELD
    --==============================================

    local shieldTime = 0

    while shieldTime < 6 do

        if activeFarm ~= farmName then
            return
        end

        task.wait(0.5)

        shieldTime += 0.5
    end

    if activeFarm ~= farmName then
        return
    end

    --==============================================
    -- HEDEF BOSSU BEKLE
    --==============================================

    setStatus(config.displayName .. " bossu aranıyor")

    local boss =
        findBossModel(config.bossName)

    local searchStart =
        tick()

    if config.offHeadDeathBySlot then
        local slotSearchStart = tick()

        while not offHeadSlot
            and activeFarm == farmName
            and tick() - slotSearchStart < 60 do

            task.wait(0.15)

            offHeadSlot = findOffHeadSlot()
        end

        if activeFarm ~= farmName then
            return
        end

        if not offHeadSlot then
            farmNeedsTeleport = true
            setStatus("OffHead slotu bulunamadı; yeniden denenecek")
            return
        end

    else
        while not boss
            and activeFarm == farmName
            and tick() - searchStart < 60 do

            task.wait(0.15)

            boss =
                findBossModel(config.bossName)
        end

        if activeFarm ~= farmName then
            return
        end

        if not boss then
            farmNeedsTeleport = true
            setStatus(
                config.displayName .. " bulunamadı; yeniden denenecek"
            )
            return
        end
    end

    farmNeedsTeleport = false
    bossBeforeSpecial = boss
    setStatus(config.displayName .. " bulundu; saldırı başlıyor")

    --==============================================
    -- UNDYNE MANTIĞI
    -- 5 → 1 → CENTER CLICK
    --==============================================

    if config.special then

        setStatus("Özel yetenek kullanılıyor")
        useSpecialAbility()

        if activeFarm ~= farmName then
            return
        end

        -- 5 SONRASI HER ZAMAN 1
        equipSword()

        task.wait(0.15)

    else

        equipSword()
    end

    setStatus(config.displayName .. " ile savaşılıyor")

    --==============================================
    -- 5 TEK BAŞINA ÖLDÜRDÜYSE
    --==============================================

    if config.offHeadDeathBySlot then

        -- Off Head'ta sadece slotun gerçekten kaybolması ölüm kabul edilir.
        -- 5 yeteneği öldürdüyse burada yakala.
        if offHeadSlot and not offHeadSlotExists(offHeadSlot) then

            registerKill(
                farmName
            )

            farmNeedsTeleport = true
            setStatus("Boss yenildi; güvenli konuma dönülüyor")

            task.wait(2)

            goSafe()

            return
        end

    elseif bossBeforeSpecial then

        if not findBossModel(
            config.bossName
        ) then

            registerKill(
                farmName
            )

            farmNeedsTeleport = true
            setStatus("Boss yenildi; güvenli konuma dönülüyor")

            task.wait(2)

            goSafe()

            return
        end
    end

    --==============================================
    -- NORMAL AUTO CLICK
    -- Off Head'ın saldırısı Undyne ile birebir aynı:
    -- equipSword() + centerClick()
    --==============================================

    local lastClick = 0

    while activeFarm == farmName do

        if activeFarm ~= farmName then
            return
        end

        if config.offHeadDeathBySlot then

            -- Off Head ölümü = yakalanan ActiveBosses slotunun yok olması
            if not offHeadSlotExists(offHeadSlot) then

                registerKill(
                    farmName
                )

                farmNeedsTeleport = true
                setStatus("Boss yenildi; güvenli konuma dönülüyor")

                task.wait(2)

                goSafe()

                return
            end

        else

            boss =
                findBossModel(
                    config.bossName
                )

            -- Diğer bossların mevcut ölüm mantığı aynen kalır.
            if not boss then

                registerKill(
                    farmName
                )

                farmNeedsTeleport = true
                setStatus("Boss yenildi; güvenli konuma dönülüyor")

                task.wait(2)

                goSafe()

                return
            end
        end

        if tick() - lastClick >= 0.10 then

            centerClick()

            lastClick = tick()
        end

        task.wait(0.03)
    end
end

