-- ANA FARM LOOP
--==================================================

task.spawn(function()

    while true do

        if activeFarm then

            local currentFarm = activeFarm

            runBoss(currentFarm)

            if activeFarm == currentFarm then

                if farmStartTime then

                    totalFarmSeconds +=
                        tick() - farmStartTime

                end

                farmStartTime = tick()

                task.wait(0.5)
            end

        else

            task.wait(0.2)
        end
    end
end)
