local function makeBossButton(key, text, x, y)

    local btn = Instance.new("TextButton")

    btn.Size = UDim2.new(0, 165, 0, 38)
    btn.Position = UDim2.new(0, x, 0, y)

    btn.BackgroundColor3 =
        Color3.fromRGB(27, 27, 35)

    btn.TextColor3 =
        Color3.fromRGB(210, 210, 220)

    btn.Text = text .. " [KAPALI]"
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.Parent = main

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 9)
    c.Parent = btn

    bossButtons[key] = btn

    btn.MouseButton1Click:Connect(function()

        autoLevel = false

        if activeFarm == key then

            activeFarm = nil

        else

            activeFarm = key
            farmStartTime = tick()
        end

        for name, b in pairs(bossButtons) do

            if name == activeFarm then

                b.Text =
                    names[
                        table.find(
                            names,
                            {name, b.Text}
                        ) or 1
                    ]

                b.BackgroundColor3 =
                    Color3.fromRGB(65, 35, 95)

            else

                b.BackgroundColor3 =
                    Color3.fromRGB(27, 27, 35)
            end
        end
    end)

    return btn
end

