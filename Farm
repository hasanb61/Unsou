local function activateFarm(farmName)
    autoLevel = false
    setAutoLevelState(false)

    if activeFarm == farmName then
        releaseHeldInputs()
        pauseFarmTimer()
        activeFarm = nil
        farmStartTime = nil
        farmNeedsTeleport = true
        watercoolerNeedsReentry = false
        setStatus("Farm stopped")

        resetBossButtons()

        return
    end

    if activeFarm and farmStartTime then
        pauseFarmTimer()
    end

    releaseHeldInputs()
    activeFarm = farmName
    farmNeedsTeleport = true
    resumeFarmTimer()
    setStatus(farmConfigs[farmName].displayName .. " selected; waiting to teleport")

    resetBossButtons()
    setButtonState(farmName, true)
end

otherWorldButton.Activated:Connect(function()
