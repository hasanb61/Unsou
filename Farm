-- =========================================================
-- BOSS ATTACK
-- =========================================================

local function attackBoss(
    bossName
)

    local bossWasSeen = false

    while activeFarm do

        local boss =
            findBossModel(
                bossName
            )

        if boss then

            bossWasSeen = true

            if not userTouchingScreen then
                clickCenter()
            end

            task.wait(0.1)

        else

            if bossWasSeen then

                return true

            end

            task.wait(0.1)

        end

    end

    return false

end

-- =========================================================
-- BOSS FARM
-- =========================================================

local function runBoss(config)

    if not activeFarm then
        return
    end

    -- Bossu 5'ten önce gör
    local bossBefore =
        findBossModel(
            config.bossName
        )

    -- Bob hariç 5
    if config.special then

        useSpecialAbility()

        -- Her zaman 1'e dön
        equipSword()

        task.wait(0.15)

        -- 5 bossu öldürdüyse
        if bossBefore then

            local after =
                findBossModel(
                    config.bossName
                )

            if not after then

                registerKill(
                    activeFarm
                )

                return

            end

        end

    else

        -- Bob: 5 YOK
        equipSword()

    end

    -- Bossu bul
    local boss =
        findBossModel(
            config.bossName
        )

    if not boss then

        boss =
            waitForBoss(
                config.bossName,
                10
            )

    end

    if not boss then

        -- Özel yetenek sırasında öldüyse
        if bossBefore
            and not findBossModel(
                config.bossName
            ) then

            registerKill(
                activeFarm
            )

        end

        return

    end

    -- Kılıç auto-click
    local killed =
        attackBoss(
            config.bossName
        )

    if killed then

        registerKill(
            activeFarm
        )

    end

end

