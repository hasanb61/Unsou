-- =========================================================

local function findBossModel(bossName)

    local activeBosses =
        workspace:FindFirstChild(
            "ActiveBosses"
        )

    if not activeBosses then
        return nil
    end

    for _, slot in ipairs(
        activeBosses:GetChildren()
    ) do

        local bossesFolder =
            slot:FindFirstChild(
                "Bosses"
            )

        if bossesFolder then

            for _, obj in ipairs(
                bossesFolder:GetDescendants()
            ) do

                if obj:IsA("Model")
                    and obj.Name == bossName then

                    return obj

                end

            end

        end

    end

    return nil
end

-- =========================================================
-- BOSS BEKLE
-- =========================================================

local function waitForBoss(
    bossName,
    timeout
)

    local start =
        tick()

    while activeFarm do

        local boss =
            findBossModel(bossName)

        if boss then
            return boss
        end

        if timeout
            and tick() - start >= timeout then

            return nil

        end

        task.wait(0.1)

    end

    return nil
end

