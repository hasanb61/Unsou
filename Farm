local function getPlayerLevel()

    local success, result = pcall(function()

        local leaderstats =
            player:FindFirstChild("leaderstats")

        if not leaderstats then
            return 0
        end

        local level =
            leaderstats:FindFirstChild("LV")

        if not level then
            return 0
        end

        return tonumber(level.Value) or 0

    end)

    if success then
        return result
    end

    return 0

end

--// =========================================================
--// AUTO LEVEL BOSS
--// =========================================================

local function getAutoBoss()

    local level = getPlayerLevel()

    if level >= 5500 then
        return "Outertale"

    elseif level >= 4900 then
        return "Hyperdust"

    elseif level >= 3985 then
        return "Bob"

    elseif level >= 3250 then
        return "OffHead"

    elseif level >= 1600 then
        return "Undyne"

    elseif level >= 305 then
        return "Susportal"
    end

    return nil

end

--// =========================================================
--// HP OKU
--// =========================================================

local function getHealthPercent()

    local success, result = pcall(function()

        local playerGui =
            player:FindFirstChildOfClass("PlayerGui")

        if not playerGui then
            return nil
        end

        local playerMain =
            playerGui:FindFirstChild("PlayerMain")

        if not playerMain then
            return nil
        end

        local dark =
            playerMain:FindFirstChild("Dark")

        if not dark then
            return nil
        end

        local statHUD =
            dark:FindFirstChild("StatHUD")

        if not statHUD then
            return nil
        end

        local health =
            statHUD:FindFirstChild("Health")

        if not health then
            return nil
        end

        local digits =
            health:FindFirstChild("Digits")

        if not digits then
            return nil
        end

        local text = digits.Text

        local currentStr, maxStr =
            text:match("(%d+)[%s/]+(%d+)")

        if not currentStr or not maxStr then
            return nil
        end

        local currentHP = tonumber(currentStr)
        local maxHP = tonumber(maxStr)

        if not currentHP or not maxHP or maxHP <= 0 then
            return nil
        end

        return (currentHP / maxHP) * 100

    end)

    if success then
        return result
    end

    return nil

end

