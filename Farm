        end

    end

end)

-- =========================================================
-- HP
-- =========================================================

local function getHealthPercent()

    local success, result =
        pcall(function()

            local playerGui =
                player:FindFirstChildOfClass(
                    "PlayerGui"
                )

            if not playerGui then
                return nil
            end

            local playerMain =
                playerGui:FindFirstChild(
                    "PlayerMain"
                )

            if not playerMain then
                return nil
            end

            local dark =
                playerMain:FindFirstChild(
                    "Dark"
                )

            if not dark then
                return nil
            end

            local statHUD =
                dark:FindFirstChild(
                    "StatHUD"
                )

            if not statHUD then
                return nil
            end

            local health =
                statHUD:FindFirstChild(
                    "Health"
                )

            if not health then
                return nil
            end

            local digits =
                health:FindFirstChild(
                    "Digits"
                )

            if not digits then
                return nil
            end

            local text =
                tostring(digits.Text)

            local currentStr, maxStr =
                text:match(
                    "(%d+)[%s/]+(%d+)"
                )

            if not currentStr
                or not maxStr then

                return nil

            end

            local currentHp =
                tonumber(currentStr)

            local maxHp =
                tonumber(maxStr)

            if not currentHp
                or not maxHp
                or maxHp <= 0 then

                return nil

            end

            return
                (currentHp / maxHp) * 100

        end)

    if success then
        return result
    end

    return nil
end

-- =========================================================
-- HEAL
-- =========================================================

local function performHeal()

    if not activeFarm then
        return
    end

    local config =
        farmConfigs[activeFarm]

    if not config
        or not config.heal then

        return

    end

    if not healArmed then
        return
    end

    healArmed = false

    pressKey(
        Enum.KeyCode.Three
    )

    task.wait(0.05)

    pcall(function()

        local camera =
            workspace.CurrentCamera

        if not camera then
            return
        end

        local size =
            camera.ViewportSize

        local x =
            size.X / 2

        local y =
            size.Y - 100

        vim:SendMouseButtonEvent(
            x,
            y,
            0,
            true,
            game,
            1
        )

        task.wait(0.05)

        vim:SendMouseButtonEvent(
            x,
            y,
            0,
            false,
            game,
            1
        )

    end)

    task.wait(0.3)

    equipSword()

end

task.spawn(function()

    while true do

        task.wait(0.2)

        if activeFarm then

            local config =
                farmConfigs[activeFarm]

            if config
                and config.heal then

                local hp =
                    getHealthPercent()

                if hp then

                    if hp <= 30 then
                        performHeal()

                    elseif hp > 30 then
                        healArmed = true
                    end

                end

            end

        else

            healArmed = true

        end

    end

end)

