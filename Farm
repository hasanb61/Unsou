local function healPlayer()

    if not healArmed then
        return
    end

    local hp = getHealthPercent()

    if not hp then
        return
    end

    if hp <= 30 then

        healArmed = false

        -- 3
        pressKey(Enum.KeyCode.Three)

        task.wait(0.05)

        -- Heal butonu
        pcall(function()

            local camera = workspace.CurrentCamera

            if camera then

                local viewport = camera.ViewportSize

                local x = viewport.X / 2
                local y = viewport.Y - 100

                VirtualInputManager:SendMouseButtonEvent(
                    x,
                    y,
                    0,
                    true,
                    game,
                    1
                )

                task.wait(0.05)

                VirtualInputManager:SendMouseButtonEvent(
                    x,
                    y,
                    0,
                    false,
                    game,
                    1
                )

            end

        end)

        task.wait(0.3)

        -- Kılıca dön
        equipSword()

        task.wait(3.5)

    elseif hp > 30 then

        healArmed = true

    end

end

