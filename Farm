        local level = getLevel()

        local gold = 0

        pcall(function()

            local ls =
                player:FindFirstChild("leaderstats")

            if ls then

                local g =
                    ls:FindFirstChild("Gold")

                if g then
                    gold = tonumber(g.Value) or 0
                end
            end
        end)

        stats.Text =
            "  LEVEL: " .. level ..
            "        GOLD: " .. gold .. "\n\n" ..

            "  TOTAL KILL: " .. totalKills ..
            "        FARM TIME: " .. formatTime(farmTime) .. "\n\n" ..

            "  Undyne: " .. kills.Undyne ..
            "    Outertale: " .. kills.Outertale ..
            "    Hyperdust: " .. kills.Hyperdust .. "\n" ..

            "  Bob: " .. kills.Bob ..
