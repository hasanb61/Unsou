local function goSafe()
    pcall(function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")

        if root then
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.CFrame = safePosition
        end
    end)
end

-- Boss olunce: yuruyerek giden bosslarda odada kal, digerlerinde safe noktaya git
local function afterKill(config)
    if config.walk and SKIP_SAFE_ON_WALK then
        return
    end

    goSafe()
end

local function goWatercoolerSafe()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        warn("Could not move to the Watercooler safe position: character root was not found")
        return false
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = watercoolerSafePosition
    return true
end

